{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:page(courses|platform|cases|instructors|safety)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/support",
      "destination": "/contact#support",
      "permanent": true
    },
    {
      "source": "/labs",
      "destination": "/#labs",
      "permanent": true
    },
    {
      "source": "/:page(courses|platform|cases|instructors|safety).html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/support.html",
      "destination": "/contact#support",
      "permanent": true
    },
    {
      "source": "/labs.html",
      "destination": "/#labs",
      "permanent": true
    }
  ]
}
